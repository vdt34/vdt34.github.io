try { chcp 65001 >$null } catch {}
try { [Console]::OutputEncoding = [System.Text.Encoding]::UTF8 } catch {}
try { $OutputEncoding = [System.Text.Encoding]::UTF8 } catch {}

$global:R1_SCRIPT_DIR = $PSScriptRoot
if (-not $global:R1_SCRIPT_DIR -and $env:R1_BAT_DIR) {
    $global:R1_SCRIPT_DIR = $env:R1_BAT_DIR
}
if (-not $global:R1_SCRIPT_DIR -and $MyInvocation.MyCommand.Path) {
    $global:R1_SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Path
}
if (-not $global:R1_SCRIPT_DIR -and $MyInvocation.PSCommandPath) {
    $global:R1_SCRIPT_DIR = Split-Path -Parent $MyInvocation.PSCommandPath
}
if (-not $global:R1_SCRIPT_DIR) {
    $global:R1_SCRIPT_DIR = (Get-Location).Path
}

